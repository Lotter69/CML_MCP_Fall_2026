meta {
  name: Extract Configuration
  type: http
  seq: 10
}

put {
  url: {{base_url}}/api/v0/labs/:lab_id/nodes/:node_id/extract_configuration
  body: none
  auth: bearer
}

params:path {
  lab_id: {{lab_id}}
  node_id: {{node_id}}
}

auth:bearer {
  token: {{token}}
}

docs {
  Extracts the current running configuration from the node.
  The node must be running to extract its configuration.
}
