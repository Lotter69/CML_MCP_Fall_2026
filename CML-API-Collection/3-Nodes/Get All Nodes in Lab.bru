meta {
  name: Get All Nodes in Lab
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v0/labs/:lab_id/nodes
  body: none
  auth: bearer
}

params:path {
  lab_id: {{lab_id}}
}

auth:bearer {
  token: {{token}}
}

docs {
  Retrieves all nodes in the specified lab.
  Returns node IDs, labels, node types, and states.
}
