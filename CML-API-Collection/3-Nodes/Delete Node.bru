meta {
  name: Delete Node
  type: http
  seq: 7
}

delete {
  url: {{base_url}}/api/v0/labs/:lab_id/nodes/:node_id
  body: none
  auth: bearer
}

params:path {
  lab_id: {{lab_id}}
  node_id: {{node_id}}
}

auth:bearer {
  token: {{token}}
}

docs {
  Deletes the specified node from the lab.
  The node must be stopped first.
}
