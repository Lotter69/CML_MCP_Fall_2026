meta {
  name: Get Node by ID
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v0/labs/:lab_id/nodes/:node_id
  body: none
  auth: bearer
}

params:path {
  lab_id: {{lab_id}}
  node_id: {{node_id}}
}

auth:bearer {
  token: {{token}}
}

docs {
  Retrieves detailed information about a specific node.
}
