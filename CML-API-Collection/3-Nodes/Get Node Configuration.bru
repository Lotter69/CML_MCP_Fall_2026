meta {
  name: Get Node Configuration
  type: http
  seq: 8
}

get {
  url: {{base_url}}/api/v0/labs/:lab_id/nodes/:node_id/config
  body: none
  auth: bearer
}

params:path {
  lab_id: {{lab_id}}
  node_id: {{node_id}}
}

auth:bearer {
  token: {{token}}
}

docs {
  Retrieves the current configuration of the node.
}
