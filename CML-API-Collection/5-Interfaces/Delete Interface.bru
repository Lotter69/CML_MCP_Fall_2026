meta {
  name: Delete Interface
  type: http
  seq: 4
}

delete {
  url: {{base_url}}/api/v0/labs/:lab_id/interfaces/:interface_id
  body: none
  auth: bearer
}

params:path {
  lab_id: {{lab_id}}
  interface_id: {{interface_id}}
}

auth:bearer {
  token: {{token}}
}

docs {
  Deletes the specified interface.
  The interface must not be connected to any link.
}
