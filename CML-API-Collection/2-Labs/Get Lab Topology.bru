meta {
  name: Get Lab Topology
  type: http
  seq: 11
}

get {
  url: {{base_url}}/api/v0/labs/:lab_id/topology
  body: none
  auth: bearer
}

params:path {
  lab_id: {{lab_id}}
}

auth:bearer {
  token: {{token}}
}

docs {
  Retrieves the complete topology of the lab including nodes, links, and interfaces.
}
