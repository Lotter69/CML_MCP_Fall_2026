meta {
  name: Lab Check-in
  type: http
  seq: 14
}

put {
  url: {{base_url}}/api/v0/labs/:lab_id/check_if_converged
  body: none
  auth: bearer
}

params:path {
  lab_id: {{lab_id}}
}

auth:bearer {
  token: {{token}}
}

docs {
  Checks if the lab has converged (all nodes are in their expected state).
  Useful for automation to wait until a lab is fully started.
}
