meta {
  name: Wipe Lab
  type: http
  seq: 7
}

put {
  url: {{base_url}}/api/v0/labs/:lab_id/wipe
  body: none
  auth: bearer
}

params:path {
  lab_id: {{lab_id}}
}

auth:bearer {
  token: {{token}}
}

docs {
  Wipes the lab, removing all configuration and state from nodes.
  This stops the lab and clears all node configurations.
}
