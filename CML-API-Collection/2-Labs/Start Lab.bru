meta {
  name: Start Lab
  type: http
  seq: 5
}

put {
  url: {{base_url}}/api/v0/labs/:lab_id/start
  body: none
  auth: bearer
}

params:path {
  lab_id: {{lab_id}}
}

auth:bearer {
  token: {{token}}
}

docs {
  Starts all nodes in the specified lab.
  The lab must be in DEFINED_ON_CORE state to start.
}
