meta {
  name: Export Lab
  type: http
  seq: 10
}

get {
  url: {{base_url}}/api/v0/labs/:lab_id/download
  body: none
  auth: bearer
}

params:path {
  lab_id: {{lab_id}}
}

auth:bearer {
  token: {{token}}
}

docs {
  Exports the lab topology in YAML format.
  This can be used to backup or share labs.
}
