meta {
  name: Delete Lab
  type: http
  seq: 8
}

delete {
  url: {{base_url}}/api/v0/labs/:lab_id
  body: none
  auth: bearer
}

params:path {
  lab_id: {{lab_id}}
}

auth:bearer {
  token: {{token}}
}

docs {
  Permanently deletes the specified lab.
  This action cannot be undone. The lab must be stopped first.
}
