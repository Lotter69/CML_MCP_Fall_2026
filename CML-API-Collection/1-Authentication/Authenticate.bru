meta {
  name: Authenticate
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v0/authenticate
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("token", res.body);
  }
}

docs {
  Authenticates to the CML system and retrieves a JWT token.
  The token is automatically stored in the environment variable 'token'.
}
